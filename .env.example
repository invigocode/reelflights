# Copy this file to .env and fill in real values. Never commit .env.

# PostgreSQL connection string.
DATABASE_URL="postgresql://user:password@localhost:5432/reelflights?schema=public"

# Flight provider. Set to "mock" for local development, "real" once a
# licensed provider has been vetted and its adapter implemented.
FLIGHT_PROVIDER="mock"
FLIGHT_API_KEY=""
FLIGHT_API_BASE_URL=""

# Rate limiting (requests per window, per IP). Tune per environment.
RATE_LIMIT_SEARCH_PER_MINUTE="20"
RATE_LIMIT_AUTOCOMPLETE_PER_MINUTE="60"

# Number of trusted reverse-proxy hops in front of the app (e.g. 1 for
# Vercel's edge network). Used to correctly resolve the client IP from
# X-Forwarded-For instead of trusting it blindly.
TRUSTED_PROXY_COUNT="1"
